{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only ./src/index-worker.ts",
    "admin": "set NODE_OPTIONS=--max-old-space-size=4096 && vite",
    "dev": "concurrently npm:dev:*",
    "build:server": "tsc",
    "build:dashboard": "vite build",
    "build": "concurrently npm:build:*",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "concurrently npm:start:*",
    "lint": "eslint .",
    "format": "prettier --write .",
    "codegen": "graphql-codegen --config codegen.ts",
    "docs:shop": "spectaql docs/spectaql-shop.yml",
    "docs:admin": "spectaql docs/spectaql-admin.yml",
    "docs": "npm run docs:shop && npm run docs:admin",
    "seed": "ts-node src/scripts/seed.ts",
    "migration:generate": "ts-node src/compile-migrations.ts generate",
    "migration:run": "ts-node src/compile-migrations.ts run",
    "migration:revert": "ts-node src/compile-migrations.ts revert"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.1",
    "@tanstack/react-router": "1.166.2",
    "@tanstack/router-devtools": "1.166.2",
    "@tanstack/router-plugin": "1.166.2",
    "@vendure/admin-ui-plugin": "^3.6.2",
    "@vendure/asset-server-plugin": "^3.6.2",
    "@vendure/core": "^3.6.2",
    "@vendure/dashboard": "^3.6.2",
    "@vendure/email-plugin": "^3.6.2",
    "@vendure/graphiql-plugin": "^3.6.2",
    "adm-zip": "^0.5.17",
    "apple-signin-auth": "^2.0.0",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "graphql": "^16.12.0",
    "ioredis": "^5.8.2",
    "meilisearch": "^0.57.0",
    "multer": "^2.1.1",
    "pg": "8.16.3",
    "react-router-dom": "^7.13.0",
    "slugify": "^1.6.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^6.1.8",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vendure/cli": "^3.6.2",
    "baseline-browser-mapping": "^2.10.11",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.5.4",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "lefthook": "^2.1.6",
    "nodemailer": "^7.0.12",
    "pg-protocol": "^1.13.0",
    "prettier": "^3.7.4",
    "spectaql": "^3.0.9",
    "ts-node-dev": "^2.0.0",
    "vite": "6"
  }
}
