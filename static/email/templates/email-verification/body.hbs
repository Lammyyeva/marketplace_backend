<mjml>
  <mj-head>
    <mj-title>Verification Code</mj-title>
    <mj-preview>Your verification code</mj-preview>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f5f7">
    <mj-section padding="30px 0">
      <mj-column />

      <!-- Main card -->
      <mj-column
        width="600px"
        background-color="#ffffff"
        border-radius="8px"
        padding="30px"
      >

        <!-- Title (unchanged text) -->
        <mj-text font-size="26px" font-weight="500" padding="0 0 10px">
          Verification Code
        </mj-text>

        <mj-divider
          border-color="#e0e0e0"
          border-width="1px"
          padding="15px 0"
        />

        <!-- OTP box -->
        <mj-wrapper
          background-color="#f1f3f5"
          border-radius="10px"
          border="1px solid #e0e0e0"
          padding="25px 20px"
        >
          <mj-section padding="0">
            <mj-column>
              <mj-text
                align="center"
                font-size="40px"
                font-weight="700"
                letter-spacing="8px"
                color="#1a73e8"
                padding="10px 0"
                font-family="'Courier New', Courier, monospace"
              >
                {{otpNumber}}
              </mj-text>
            </mj-column>
          </mj-section>
        </mj-wrapper>

        <!-- Expiry text (unchanged) -->
        <mj-text
          font-size="14px"
          color="#666666"
          align="center"
          padding="20px 0 0"
        >
          This code will expire in 5 minutes.
        </mj-text>

      </mj-column>

      <mj-column />
    </mj-section>
  </mj-body>
</mjml>