
# App
APP_ENV=dev
PORT=3000
HOST=0.0.0.0
COOKIE_SECRET=change-me
COOKIE_EXPIRY=2d

# SuperAdmin
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me

# Email
GMAIL_ADDRESS=your@gmail.com
GMAIL_PASSWORD=your-app-password

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SCHEMA=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
ACCESS_TOKEN_TIME=1d
REFRESH_TOKEN_TIME=3d
REFRESH_TOKEN_LIMIT=4
SECRET_KEY=change-me

# Social login
# Google OAuth client id (used by GoogleAuthenticationStrategy; matches frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
CLIENT_ID=
# Apple Services ID (audience) used to verify Apple identity tokens
APPLE_CLIENT_ID=

# OTP / phone password recovery (SMS provider)
OTP_URL=
OTP_USERNAME=
OTP_PASSWORD=
# OTP tuning (defaults: 5min TTL, 5 wrong attempts, 5 sends per 15min window)
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=5
OTP_RATE_WINDOW_MS=900000

# MeiliSearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# ─── MinIO / S3-compatible Object Storage ───────────────────────────────────
#
# MINIO_ENDPOINT   – internal URL the backend uses to talk to MinIO (can be
#                    a private network address).
# MINIO_PUBLIC_URL – externally reachable base URL embedded in every asset URL
#                    returned by the API (preview, source, featuredAsset …).
#                    Set this to your CDN or reverse-proxy address in production.
#                    Falls back to MINIO_ENDPOINT when omitted.
#
# Resulting asset URLs will look like:
#   {MINIO_PUBLIC_URL}/{MINIO_BUCKET}/preview/ab/image.webp
#
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vendure-assets
MINIO_PUBLIC_URL=http://localhost:9000
